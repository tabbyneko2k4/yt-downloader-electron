{
  "manifest_version": 3,
  "name": "Nyanko's Media Downloader",
  "version": "1.0.0",
  "description": "Tự động phát hiện media từ tab hiện tại và tải video/audio về ứng dụng Nyanko's Media Downloader Desktop.",
  "permissions": [
    "activeTab",
    "tabs",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "http://127.0.0.1:38472/*",
    "http://localhost:38472/*",
    "*://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "Nyanko's Media Downloader"
  }
}
