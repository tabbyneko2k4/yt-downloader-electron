{
  "name": "media-downloader",
  "version": "1.2.0",
  "description": "A multi-source media downloader powered by yt-dlp, FFmpeg, Electron and React",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build:react": "vite build",
    "build:extension": "vite build --config chrome-extension/vite.config.js",
    "start": "electron .",
    "build": "vite build && electron-builder --windows",
    "build:installer": "vite build && node build-installer.js",
    "start:installer": "electron ./installer"
  },
  "keywords": [
    "yt-dlp",
    "ffmpeg",
    "electron",
    "react",
    "downloader",
    "youtube",
    "tiktok",
    "facebook",
    "soundcloud",
    "gif",
    "mp3",
    "mp4"
  ],
  "author": "Tabby Neko",
  "license": "ISC",
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.26.0",
    "postcss": "^8.5.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^3.4.19",
    "vite": "^5.4.21"
  },
  "build": {
    "appId": "com.tabbyneko.mediadownloader",
    "productName": "Media Downloader",
    "icon": "icon/icon.png",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "icon/icon.png",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "files": [
      "dist-react/**/*",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "asar": true
  }
}
